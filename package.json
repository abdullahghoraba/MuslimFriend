{
  "name": "muslim-friend",
  "version": "1.0.6",
  "scripts": {
    "ng": "ng",
    "start": "npm run content && ng serve",
    "content": "node scripts/build-content.mjs && node scripts/build-quran.mjs",
    "content:check": "node scripts/build-content.mjs --check && node scripts/build-quran.mjs --check",
    "build": "npm run content && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run content:check && ng test --watch=false",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "i18n": "node scripts/merge-i18n.mjs",
    "test:android": "node scripts/gradle.mjs testDebugUnitTest",
    "release": "npm run i18n && npm run content && node scripts/personal-tafsir.mjs --clear && ng build && npx cap sync android && node scripts/gradle.mjs :app:clean bundleRelease && node -e \"const fs=require('fs');fs.mkdirSync('release',{recursive:true});fs.copyFileSync('android/app/build/outputs/bundle/release/app-release.aab','release/app-release.aab')\"",
    "apk:debug": "npm run i18n && npm run content && node scripts/personal-tafsir.mjs && ng build && npx cap sync android && node scripts/gradle.mjs :app:clean assembleDebug",
    "e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@ionic/angular": "9.0.8",
    "@ngx-translate/core": "18.0.0",
    "@ngx-translate/http-loader": "18.0.0",
    "adhan": "4.4.6",
    "html-to-image": "1.11.13",
    "ionicons": "8.1.0",
    "jeep-sqlite": "2.8.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@capacitor/cli": "8.5.3",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1"
  },
  "overrides": {
    "sql.js": "1.11.0"
  }
}
